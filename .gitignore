# Track only the skill surfaces. Everything else in ~/.claude is machine state,
# session transcripts, or cache and must never be committed.
/*
!/.gitignore
!/README.md
!/AGENTS.md
!/.devin-plugin/
!/install.sh
!/skills/
!/skills-staging/
!/skills-disabled/
!/scripts/
!/hooks/
skills/**/.backups/
hooks/*.log
skills/synced/
